# ─────────────────────────────────────────────────────────────────────────────
# Avatar Reel Pack — environment variables
# Copy this file to ".env" and fill in YOUR values. Never commit the real .env.
# All skills read keys by NAME from the environment; no secret is ever hardcoded.
# ─────────────────────────────────────────────────────────────────────────────

# ── HeyGen (avatar render) ── REQUIRED ──
# Your HeyGen API key. The avatar id of your trained avatar goes in
# .claude/skills/avatar-reel/identity.json, NOT here.
HEYGEN_API_KEY=
# The private group id used to list your avatar looks
# (heygen avatar looks list --group-id $AVATAR_GROUP_ID --ownership private)
AVATAR_GROUP_ID=
# Optional: expected look/avatar id (should match identity.json)
AVATAR_LOOK_ID=

# ── Gemini (voice / TTS) ── REQUIRED ──
GEMINI_API_KEY=

# ── ElevenLabs (optional voice cloning, only for gemini_tts_elevenlabs mode) ──
ELEVENLABS_API_KEY=

# ── Suno via Kie.ai (optional background music) ──
KIE_API_KEY=
# Some setups use this name instead; either is accepted by music-ugc:
# SUNO_KIE_API_KEY=

# ── OpenAI (optional: Whisper transcription fallback for captions) ──
OPENAI_API_KEY=
